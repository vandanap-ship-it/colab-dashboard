{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/overdue-digest",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/progress-nudge",
      "schedule": "0 6 * * 1-6"
    },
    {
      "path": "/api/cron/daily-tasks",
      "schedule": "30 1 * * 1-6"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "30 1 * * 5"
    },
    {
      "path": "/api/cron/waiting-nudge",
      "schedule": "30 2 * * 1-6"
    },
    {
      "path": "/api/cron/notification-cleanup",
      "schedule": "30 21 * * *"
    }
  ]
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique // required for assignment / milestone notifications
  name         String
  passwordHash String
  role         String   @default("SITE_ENGINEER")
  designation  String?
  modules      String? // JSON array of allowed module keys; null = full access (internal staff)
  active       Boolean  @default(true)
  // Optional contractor tie — populated for external users so that
  // inspections / issues / snags they file can be attributed back to
  // their contractor even when the underlying WBS row has no contractor
  // tag (Colab imports come in like that). Nullable for internal staff
  // and for any user we haven't tagged yet.
  contractorId String?
  // Opt-in flags for daily site-team automations. Both replace hardcoded
  // username allowlists in the cron endpoints — Admin > Users toggles
  // the same setting so the set of recipients isn't buried in code.
  //   receivesDailyTaskEmail = 07:00 IST "today's schedule" email
  //   receivesDailyNudge     = 11:30 IST push if no progress/manpower logged
  receivesDailyTaskEmail Boolean @default(false)
  receivesDailyNudge     Boolean @default(false)
  // Whether this user is offered in the Work Permit approver picker. Replaces
  // the old "every internal-staff user is an eligible approver" default so
  // authority stays with the site manager(s) actually responsible for the
  // approve/reject decision.
  canApproveWorkPermits  Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contractor               Contractor?             @relation(fields: [contractorId], references: [id])

  createdProjects          Project[]               @relation("ProjectCreator")
  progressEntries          ProgressEntry[]
  hindrances               Hindrance[]
  raisedConcerns           Concern[]               @relation("ConcernRaiser")
  assignedConcerns         Concern[]               @relation("ConcernAssignee")
  createdIssues            Issue[]                 @relation("IssueCreator")
  assignedIssues           Issue[]                 @relation("IssueAssignee")
  responsiblePermits       Permit[]                @relation("PermitResponsible")
  filledInspections        Inspection[]            @relation("InspectionFiller")
  reviewedInspections      Inspection[]            @relation("InspectionReviewer")
  preparedBills            SubContractorBill[]     @relation("BillPreparer")
  approvedBills            SubContractorBill[]     @relation("BillApprover")
  createdDesignDrawings    DesignDrawing[]         @relation("DrawingCreator")
  uploadedDrawingRevisions DesignDrawingRevision[] @relation("RevisionUploader")
  createdTradePlans        TradePlan[]             @relation("TradePlanCreator")
  loggedManpower           ManpowerEntry[]         @relation("ManpowerEntryCreator")
  requestedWorkPermits     WorkPermit[]            @relation("WorkPermitRequester")
  approvedWorkPermits      WorkPermit[]            @relation("WorkPermitApprover")
  closedWorkPermits        WorkPermit[]            @relation("WorkPermitCloser")
  pushSubscriptions        PushSubscription[]
  notifications            Notification[]
}

/// Web Push subscriptions per user. One user may have multiple entries when
/// they enable Siddhi on both a phone and a desktop, or reinstall the app.
/// The `endpoint` from the browser is globally unique per device+origin, so
/// resubscribing from the same device just updates the row via upsert.
///
/// Deleted on the server the first time we try to send to a 404/410 endpoint
/// (the browser has unsubscribed the user permanently — no point holding a
/// dead subscription).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Persistent inbox for every push notification we send. sendPushToUser
/// writes here in the same call that fires the browser push, so the bell
/// in the mobile bottom nav can show unread counts + a scrollable history
/// even when the user missed the push (phone off, tab closed, browser
/// hostile to service workers). One row per (user, event) — the push
/// payload's `tag` slot is stored so a follow-up can replace an existing
/// entry (e.g. a nudge push overwrites yesterday's nudge rather than
/// stacking). Deletion cascades with the user.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  /// Deep-link URL. Path-only (e.g. /mobile/proj/rfi/123) — no origin.
  url       String?
  /// Push-payload tag; carried through so the client can dedupe by it.
  tag       String?
  createdAt DateTime  @default(now())
  /// Timestamp of when the user marked this notification as read; NULL
  /// means it's still in the unread badge. Read is a first-class event
  /// (not just a soft delete) so we can show a small "12 read this week"
  /// footer + drive the unread-only default view.
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Compound index that carries both list queries: unread rows for the
  /// badge count (WHERE userId=? AND readAt IS NULL) and the full history
  /// for the inbox (WHERE userId=? ORDER BY createdAt DESC).
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Project {
  id               String    @id @default(cuid())
  name             String
  code             String?
  status           String    @default("PLANNING")
  startDate        DateTime?
  endDate          DateTime?
  reraEndDate      DateTime?
  actualStartDate  DateTime?
  projectedEndDate DateTime?
  address          String?
  tagline          String?
  logoUrl          String?
  // Free-form-ish category so the landing table can group / filter — display
  // labels live in src/lib/projectTypes.ts. Nullable so existing rows don't
  // need a backfill.
  projectType      String?
  // Master plan / site layout image (isometric aerial view with villa plots
  // labelled) — powers the Progress tab's Interactive Drawing. Stored in
  // Vercel Blob; nullable until admin uploads.
  masterPlanUrl    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String
  createdBy        User      @relation("ProjectCreator", fields: [createdById], references: [id])

  wbsNodes           WBSNode[]
  contractors        Contractor[]
  progressEntries    ProgressEntry[]
  hindrances         Hindrance[]
  concerns           Concern[]
  issues             Issue[]
  inspections        Inspection[]
  drawings           ProjectDrawing[]
  subContractorBills SubContractorBill[]
  designDrawings     DesignDrawing[]
  blocks             Block[]
  villas             Villa[]
  milestoneSections  MilestoneSection[]
  permits            Permit[]
  workPermits        WorkPermit[]
  tradePlans         TradePlan[]
  manpowerEntries    ManpowerEntry[]

  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Villa Project structure (executive rollup)
//
// A villa project like Amanvana is organised as a set of Blocks, each holding
// a small group of Villas. Each Villa moves through the same ordered list of
// MilestoneSections (Foundation → Plinth → ... → Handover) with its own
// baseline / actual / projected dates. Progress on WBS activities rolls up
// into VillaMilestone.pctComplete; villa slip = max milestone slip; block slip
// = max villa slip. This drives the executive dashboard's block/villa health
// buckets and the layout site plan.
// ---------------------------------------------------------------------------
model Block {
  id         String  @id @default(cuid())
  projectId  String
  code       String // "4", "9", "10", "14", "3A", "3B", ...
  name       String? // display name if different from code
  pod        String? // grouping e.g. "Central East", "South Row East"
  orderIndex Int     @default(0)
  active     Boolean @default(true) // true once execution has begun

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  villas  Villa[]

  @@unique([projectId, code])
  @@index([projectId])
}

model Villa {
  id        String  @id @default(cuid())
  projectId String
  blockId   String
  number    Int // 12, 13, 14, ... (primary villa number even for grouped villas)
  villaType String? // "A", "B", ...
  inScope   Boolean @default(true) // false for model villas / out-of-scope plots
  // Some villas in MSP are grouped as one scheduling unit ("Villa 10 & 11",
  // "Villa 23 & 24") — built together, share tasks. We keep one Villa record
  // per group but count physical units correctly via unitCount.
  unitCount Int     @default(1)
  label     String? // display override, e.g. "Villa 10 & 11". Falls back to "Villa {number}".

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  block      Block            @relation(fields: [blockId], references: [id], onDelete: Cascade)
  milestones VillaMilestone[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([blockId])
}

// Project-scoped ordered milestone list. NOT an enum — each villa project can
// tune its own sections (Amanvana's 21 differ from a highrise's 15).
model MilestoneSection {
  id         String @id @default(cuid())
  projectId  String
  code       String // stable slug, e.g. "FOUNDATION", "PLINTH"
  name       String // display, e.g. "Foundation / Substructure"
  orderIndex Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones VillaMilestone[]

  @@unique([projectId, code])
  @@index([projectId])
}

model VillaMilestone {
  id        String @id @default(cuid())
  villaId   String
  sectionId String

  baselineStart   DateTime?
  baselineFinish  DateTime?
  actualStart     DateTime?
  actualFinish    DateTime?
  projectedFinish DateTime?

  pctComplete Float   @default(0)
  delayReason String?
  // Days since last field update on any linked activity — feeds Data Hygiene.
  staleDays   Int?

  // CRM integration — Colab ties each construction milestone to a customer
  // payment stage. When the milestone hits (or its projected date moves),
  // the CRM collection stage shifts too. Null when the villa has no buyer yet.
  crmDate           DateTime?
  crmDelay          Int? // days between planned and CRM-committed date
  plannedCollection Float? // INR expected at this milestone

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  villa    Villa            @relation(fields: [villaId], references: [id], onDelete: Cascade)
  section  MilestoneSection @relation(fields: [sectionId], references: [id])
  wbsNodes WBSNode[]

  @@unique([villaId, sectionId])
  @@index([villaId])
  @@index([sectionId])
}

model Contractor {
  id        String   @id @default(cuid())
  projectId String
  name      String
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progressEntries ProgressEntry[]
  wbsNodes        WBSNode[]
  bills           SubContractorBill[]
  tradePlans      TradePlan[]
  manpowerEntries ManpowerEntry[]
  workPermits     WorkPermit[]
  users           User[]
  hindrancesResponsibleFor Hindrance[] @relation("HindranceResponsibleContractor")

  @@unique([projectId, name])
  @@index([projectId])
}

model WBSNode {
  id         String  @id @default(cuid())
  projectId  String
  parentId   String?
  taskCode   String
  name       String
  level      Int
  orderIndex Int

  baselineStart   DateTime?
  baselineFinish  DateTime?
  actualStart     DateTime?
  actualFinish    DateTime?
  projectedFinish DateTime?

  percentComplete Float @default(0)

  category        String?
  predecessorsRaw String?

  totalQuantity   Float?
  unit            String?
  contractorId    String?
  delayReason     String?
  progressEntered Boolean @default(false)

  // Colab CSV "Physical_Progress" — the activity's WEIGHT contribution to
  // overall project completion (0-100, all rows sum to ~100). Kept per
  // matched wbsNode for legacy queries. The authoritative sum for §1 lives
  // in the ColabActivity table below (one row per Colab CSV row — MSP and
  // Colab activities don't 1:1 map, so wbsNode-only sums undercount).
  weightPct       Float?

  // Executive rollup: which villa + milestone section this activity feeds into.
  // Set on leaf activities; null on structural / parent nodes.
  villaId          String?
  sectionId        String?
  villaMilestoneId String? // direct link to the per-villa-per-section instance
  // ★ concreting checkpoints (Footing RCC, Raft RCC, Retaining Wall, etc.).
  // Everything else is a task item that rolls up to the next sub-milestone.
  isSubMilestone   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          WBSNode?                @relation("WBSTree", fields: [parentId], references: [id])
  children        WBSNode[]               @relation("WBSTree")
  contractor      Contractor?             @relation(fields: [contractorId], references: [id])
  villaMilestone  VillaMilestone?         @relation(fields: [villaMilestoneId], references: [id])
  progressEntries ProgressEntry[]
  hindrances      Hindrance[]
  concerns        Concern[]
  issues          Issue[]
  inspections     Inspection[]
  workPermits     WorkPermit[]
  billLines       SubContractorBillLine[]

  @@unique([projectId, taskCode])
  @@index([projectId])
  @@index([parentId])
  @@index([villaId])
  @@index([sectionId])
  @@index([villaMilestoneId])
}

model ProgressEntry {
  id        String   @id @default(cuid())
  projectId String
  wbsNodeId String
  date      DateTime
  type      String   @default("LABOUR_SUPPLY")

  achievedQuantity   Float @default(0)
  cumulativeQuantity Float @default(0)

  contractorId String?
  notes        String?

  // Optional root-cause tag on late progress. Colab CSVs carry a
  // Reason_for_Delay column on each progress row — this brings us to parity
  // so the site engineer can log a reason without opening a Hindrance.
  // Same taxonomy as Hindrance (src/lib/hindranceReasons.ts).
  reasonCode  String?
  reasonNote  String?

  /// Progress entry lifecycle. PUBLISHED rows are the ones every rollup,
  /// report and export considers real; DRAFT rows are the engineer's
  /// unfinished attempts, visible only to them under the Drafts tab of
  /// the Progress list. Kept as text (not a Prisma enum) so a future
  /// third state can land as a data change rather than a migration.
  /// Default keeps every existing row PUBLISHED, so this add is fully
  /// backwards-compatible.
  status         String    @default("PUBLISHED")

  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  idempotencyKey String?   @unique // de-dupes offline-queue replays

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode          @relation(fields: [wbsNodeId], references: [id])
  contractor Contractor?      @relation(fields: [contractorId], references: [id])
  createdBy  User             @relation(fields: [createdById], references: [id])
  labour     ProgressLabour[]
  photos     ProgressPhoto[]

  @@index([projectId, date])
  @@index([wbsNodeId])
}

model ProgressLabour {
  id              String @id @default(cuid())
  progressEntryId String
  category        String
  count           Int

  progressEntry ProgressEntry @relation(fields: [progressEntryId], references: [id], onDelete: Cascade)

  @@index([progressEntryId])
}

model ProgressPhoto {
  id              String   @id @default(cuid())
  progressEntryId String
  url             String
  uploadedAt      DateTime @default(now())

  progressEntry ProgressEntry @relation(fields: [progressEntryId], references: [id], onDelete: Cascade)

  @@index([progressEntryId])
}

model Hindrance {
  id           String    @id @default(cuid())
  projectId    String
  wbsNodeId    String?
  description  String
  startDate    DateTime
  endDate      DateTime? // expected / actual end of blocker (paired with startDate)
  resolvedDate DateTime?
  daysImpact   Int?
  status       String    @default("OPEN")

  // Root-cause tagging so the Dashboard can cluster blockers by reason.
  // Values come from src/lib/hindranceReasons.ts (MATERIAL / LABOUR / RMC / …).
  reasonCode String?
  reasonNote String?

  // Responsibility (distinct from `createdBy`, which is the reporter). The
  // contractor is a FK so filters and rollups can group cleanly; the team is
  // free text until we model Team as its own entity.
  responsibleContractorId String?
  responsibleTeam         String?

  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  idempotencyKey String?   @unique // de-dupes offline-queue replays

  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode              WBSNode?         @relation(fields: [wbsNodeId], references: [id])
  createdBy            User             @relation(fields: [createdById], references: [id])
  responsibleContractor Contractor?     @relation("HindranceResponsibleContractor", fields: [responsibleContractorId], references: [id])
  photos               HindrancePhoto[]

  @@index([projectId])
  @@index([responsibleContractorId])
}

model HindrancePhoto {
  id          String   @id @default(cuid())
  hindranceId String
  url         String
  uploadedAt  DateTime @default(now())

  hindrance Hindrance @relation(fields: [hindranceId], references: [id], onDelete: Cascade)

  @@index([hindranceId])
}

model Concern {
  id           String  @id @default(cuid())
  projectId    String
  wbsNodeId    String?
  description  String
  status       String  @default("PENDING")
  assignedToId String?

  raisedById     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  idempotencyKey String?   @unique // de-dupes offline-queue replays

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?       @relation(fields: [wbsNodeId], references: [id])
  raisedBy   User           @relation("ConcernRaiser", fields: [raisedById], references: [id])
  assignedTo User?          @relation("ConcernAssignee", fields: [assignedToId], references: [id])
  photos     ConcernPhoto[]

  @@index([projectId])
  @@index([assignedToId])
}

model ConcernPhoto {
  id         String   @id @default(cuid())
  concernId  String
  url        String
  uploadedAt DateTime @default(now())

  concern Concern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@index([concernId])
}

model Issue {
  id          String  @id @default(cuid())
  projectId   String
  wbsNodeId   String?
  description String
  severity    String?
  category    String?
  status      String  @default("OPEN")

  createdById  String
  assignedToId String?
  module       String? // QAQC | SAFETY | null (general). Scopes visibility for contractor users.

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  idempotencyKey String?   @unique // de-dupes offline-queue replays

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?     @relation(fields: [wbsNodeId], references: [id])
  createdBy  User         @relation("IssueCreator", fields: [createdById], references: [id])
  assignedTo User?        @relation("IssueAssignee", fields: [assignedToId], references: [id])
  photos     IssuePhoto[]

  @@index([projectId])
  @@index([assignedToId])
}

model IssuePhoto {
  id         String   @id @default(cuid())
  issueId    String
  url        String
  uploadedAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// ---------------------------------------------------------------------------
// Permit — legal / regulatory approvals with expiry tracking.
//
// Examples: BBMP Building Permit, KSPCB Consent to Operate, Fire NOC, Labour
// License, Ground Water permit. Each has an issuing authority, a number,
// issue + expiry dates, and a responsible person. Status is derived from the
// expiry date (see canonicalPermitStatus in src/lib/permit.ts) but stored
// explicitly so users can override (e.g. RENEWED before expiry).
// ---------------------------------------------------------------------------
model Permit {
  id                  String    @id @default(cuid())
  projectId           String
  name                String
  number              String? // issuing authority's permit number (e.g. BBMP/2026/12345)
  issuingAuthority    String
  category            String // BUILDING | ENVIRONMENTAL | FIRE | LABOUR | WATER | OTHER
  issuedDate          DateTime
  expiryDate          DateTime?
  documentUrl         String? // uploaded PDF / image of the permit
  notes               String?
  status              String    @default("ACTIVE") // ACTIVE | EXPIRING_SOON | EXPIRED | RENEWED
  responsibleUserId   String?
  renewalReminderDays Int       @default(30) // how far ahead to flag as EXPIRING_SOON

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible User?   @relation("PermitResponsible", fields: [responsibleUserId], references: [id])

  @@unique([projectId, name, number]) // don't accidentally re-add the same permit
  @@index([projectId])
  @@index([responsibleUserId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// WorkPermit — daily site permits (Hot Work, Night Work, De-shuttering, etc.).
//
// Different from `Permit` above (which is annual/multi-year regulatory
// approvals). WorkPermits are per-day work authorizations raised by an HSE
// Officer / Site Engineer / Safety Officer, approved by a Safety Manager
// before work starts, and closed at end of day.
//
// State machine:
//   PENDING → APPROVED → CLOSED      (happy path)
//   PENDING → REJECTED               (approver refuses)
//   APPROVED → REJECTED              (only until closed — approver realizes
//                                     the setup is unsafe after all)
//
// First-approver-wins semantics: `approverIds` is a JSON array of user IDs
// who CAN approve; whichever one clicks first stamps `approvedById` and the
// row transitions to APPROVED. Matches the workflow the CSV import shows.
// ---------------------------------------------------------------------------
model WorkPermit {
  id           String @id @default(cuid())
  projectId    String
  // Free-form so we can add new types (e.g. "Confined Space", "Excavation")
  // without a schema migration. Display labels live in src/lib/workPermit.ts.
  // Known set at v1: HOT_WORK | NIGHT_WORK | DESHUTTERING | GENERAL
  type         String
  title        String // one-line summary shown in lists
  description  String? // free-form details about the work being permitted
  // The day the work is authorized for. Time-of-day fields are separate so
  // the same permit can span an evening-into-night without spanning dates.
  workDate     DateTime
  startTime    String // "HH:MM" 24-hour, e.g. "09:00"
  endTime      String // "HH:MM" 24-hour, e.g. "18:00"
  // Free-text location — Colab's export shows values like "Villa 14 / Gr Floor"
  // or "All Locations". Free text is expressive enough without forcing every
  // permit to bind to a WBSNode.
  location     String?
  contractorId String? // optional — some permits (Night Work) name a contractor
  wbsNodeId    String? // optional link to a specific activity
  requesterId  String
  // JSON array of User.id strings that can approve. First-approver-wins.
  approverIds  String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CLOSED
  approvedById String?
  approvedAt   DateTime?
  closedById   String?
  closedAt     DateTime?
  rejectedById String?
  rejectedAt   DateTime?
  rejectionReason String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  idempotencyKey String?   @unique // de-dupes offline-queue replays

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor?       @relation(fields: [contractorId], references: [id])
  wbsNode    WBSNode?          @relation(fields: [wbsNodeId], references: [id])
  requester  User              @relation("WorkPermitRequester", fields: [requesterId], references: [id])
  approver   User?             @relation("WorkPermitApprover", fields: [approvedById], references: [id])
  closer     User?             @relation("WorkPermitCloser", fields: [closedById], references: [id])
  photos     WorkPermitPhoto[]

  @@index([projectId])
  @@index([requesterId])
  @@index([approvedById])
  @@index([status])
  @@index([workDate])
}

model WorkPermitPhoto {
  id           String   @id @default(cuid())
  workPermitId String
  url          String
  uploadedAt   DateTime @default(now())

  workPermit WorkPermit @relation(fields: [workPermitId], references: [id], onDelete: Cascade)

  @@index([workPermitId])
}

model Inspection {
  id              String  @id @default(cuid())
  projectId       String
  wbsNodeId       String?
  title           String
  status          String  @default("IN_REVIEW") // IN_REVIEW | PASSED | REJECTED | RESCHEDULED
  rejectionReason String?

  filledById     String
  reviewedById   String?
  reviewedAt     DateTime?
  module         String? // QAQC | SAFETY | null (general). Scopes visibility for contractor users.
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  idempotencyKey String?   @unique // de-dupes offline-queue replays

  // Colab-parity fields — added Sep 2026:
  //   submitRemark        - free-text sent alongside Send For Review, so the
  //                         reviewer opens the WIR with the filler's context.
  //   assignedReviewerIds - the specific reviewers the filler picked. When
  //                         empty, the API falls back to a role-based
  //                         broadcast (planners + product + admin).
  //   rescheduledFor      - when status=RESCHEDULED, the date the inspection
  //                         should be reopened. Null on any other status.
  //   rescheduledNote     - optional reason (e.g. "waiting on rebar delivery").
  submitRemark        String?
  assignedReviewerIds String[]  @default([])
  rescheduledFor      DateTime?
  rescheduledNote     String?

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?          @relation(fields: [wbsNodeId], references: [id])
  filledBy   User              @relation("InspectionFiller", fields: [filledById], references: [id])
  reviewedBy User?             @relation("InspectionReviewer", fields: [reviewedById], references: [id])
  items      InspectionItem[]
  photos     InspectionPhoto[]

  @@index([projectId])
  @@index([wbsNodeId])
}

model InspectionItem {
  id           String   @id @default(cuid())
  inspectionId String
  label        String
  // Yes / No / NA response. Kept as two columns for backward compat:
  //   notApplicable = true                    → NA
  //   notApplicable = false, passed = true    → Yes
  //   notApplicable = false, passed = false   → No
  //   notApplicable = false, passed = null    → not answered
  // Pre-Jun-2026 rows are all Yes (legacy).
  passed        Boolean?
  notApplicable Boolean  @default(false)
  notes         String?
  // Optional per-checkpoint photo (Colab parity). One photo per row, not a
  // gallery — the reviewer just needs "did you actually see this row" not
  // a documentary. The whole-checklist InspectionPhoto[] remains for the
  // wider evidence (progress shot, overall context photo).
  photoUrl      String?
  orderIndex    Int      @default(0)

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model InspectionPhoto {
  id           String   @id @default(cuid())
  inspectionId String
  url          String
  uploadedAt   DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model ProjectDrawing {
  id        String   @id @default(cuid())
  projectId String
  label     String
  kind      String   @default("LAYOUT")
  imageUrl  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Reusable inspection checklist templates (the White Lotus QA/QC library).
// A site engineer picks a template and its checkpoints pre-fill the inspection
// form, instead of typing items by hand. Templates are global (not per-project)
// and tagged by module so QAQC vs Safety contractors see the right set.
model InspectionTemplate {
  id         String   @id @default(cuid())
  code       String   @unique // e.g. "CL-QC-01"
  name       String // e.g. "Marking Setting Out"
  activity   String? // e.g. "MARKING"
  module     String? // QAQC | SAFETY | null (general)
  orderIndex Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items InspectionTemplateItem[]
}

model InspectionTemplateItem {
  id          String  @id @default(cuid())
  templateId  String
  seq         Int
  section     String? // optional grouping, e.g. "SETTING OUT" / "POST-EXECUTION CHECKS"
  description String

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// Records every meaningful create / update / delete across the system so that
// "who changed this snag?" or "when did this entry get edited?" has an answer.
// Kept lightweight: we record the action, entity, actor, and a compact change
// summary; we don't try to mirror every field of every model.
model AuditLog {
  id         String  @id @default(cuid())
  projectId  String?
  userId     String
  action     String // CREATE | UPDATE | DELETE | RESTORE | STATUS_CHANGE
  entityType String // ProgressEntry | Issue | Hindrance | Concern | Inspection | Project | User | Contractor
  entityId   String
  summary    String? // short human-readable description, e.g. "Snag closed" or "Progress %: 30 -> 45"
  changes    String? // optional JSON for richer diffs

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// P2P — Sub-contractor billing (Phase 1)
//
// A bill is a claim from a sub-contractor for a period of work. It supports all
// three billing bases the team uses, one per line item:
//   ITEM_RATE  → quantity x rate (e.g. m3 of concrete)
//   LABOUR     → headcount x rate (uses the labour data already captured)
//   LUMP_SUM   → a fixed amount (milestone payments)
//
// The bill total is always derived from its line items (+ optional tax), never
// stored, so it can't drift. Two-step approval: a planner prepares and submits,
// a manager/admin approves (or rejects). Money is only TRACKED here — the app
// never moves funds.
// ---------------------------------------------------------------------------
model SubContractorBill {
  id              String    @id @default(cuid())
  projectId       String
  contractorId    String
  title           String
  periodStart     DateTime?
  periodEnd       DateTime?
  // DRAFT | SUBMITTED | APPROVED | REJECTED | PAID
  status          String    @default("DRAFT")
  notes           String?
  // Optional tax (e.g. GST). null = no tax applied; total = subtotal otherwise.
  taxPercent      Float?
  // Approval trail.
  preparedById    String
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  idempotencyKey String?   @unique // de-dupes offline-queue replays

  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor              @relation(fields: [contractorId], references: [id])
  preparedBy User                    @relation("BillPreparer", fields: [preparedById], references: [id])
  approvedBy User?                   @relation("BillApprover", fields: [approvedById], references: [id])
  lineItems  SubContractorBillLine[]

  @@index([projectId])
  @@index([contractorId])
}

model SubContractorBillLine {
  id          String  @id @default(cuid())
  billId      String
  type        String // ITEM_RATE | LABOUR | LUMP_SUM
  description String
  wbsNodeId   String? // optional link to the activity being billed
  quantity    Float? // qty (ITEM_RATE) or headcount (LABOUR)
  unit        String? // m3, nos, mason-days, etc.
  rate        Float? // amount per unit
  amount      Float   @default(0) // line total: quantity*rate, or the lump sum
  orderIndex  Int     @default(0)

  bill    SubContractorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  wbsNode WBSNode?          @relation(fields: [wbsNodeId], references: [id])

  @@index([billId])
}

// ---------------------------------------------------------------------------
// Design Drawing Register (Phase 1)
//
// The canonical list of design drawings for a project — architectural,
// structural, MEP, interior, landscape. Each drawing has a stable drawing
// number (e.g. "A-104", "S-201") and a chain of revisions, each pointing at
// its own uploaded file. The drawing's currentRevisionId points at the latest
// one so "open the current version" is a single hop.
// Distinct from the existing ProjectDrawing model, which is for dashboard
// layout images, not the design register.
// ---------------------------------------------------------------------------
model DesignDrawing {
  id                String  @id @default(cuid())
  projectId         String
  drawingNumber     String
  title             String
  // ARCHITECTURAL | STRUCTURAL | MEP | INTERIOR | LANDSCAPE | OTHER
  discipline        String
  notes             String?
  currentRevisionId String?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("DrawingCreator", fields: [createdById], references: [id])
  currentRevision DesignDrawingRevision?  @relation("CurrentRevisionOf", fields: [currentRevisionId], references: [id])
  revisions       DesignDrawingRevision[] @relation("DrawingRevisions")

  // Drawing number is unique per project (you can't have two A-104s).
  @@unique([projectId, drawingNumber])
  @@index([projectId])
  @@index([projectId, discipline])
}

model DesignDrawingRevision {
  id            String   @id @default(cuid())
  drawingId     String
  revisionLabel String // "R0", "R1", "A", "B", etc.
  fileUrl       String // PDF / image stored in Vercel Blob
  fileName      String // original filename for download UX
  issuedDate    DateTime // when the designer issued this version
  notes         String? // what changed in this revision
  uploadedById  String
  uploadedAt    DateTime @default(now())

  drawing    DesignDrawing   @relation("DrawingRevisions", fields: [drawingId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("RevisionUploader", fields: [uploadedById], references: [id])
  // Inverse of DesignDrawing.currentRevision so Prisma can validate the
  // relation. In practice each revision is "current" for at most one drawing.
  currentOf  DesignDrawing[] @relation("CurrentRevisionOf")

  @@index([drawingId])
}

// ---------------------------------------------------------------------------
// Manpower — planned vs actual daily headcount by trade
//
// TradePlan holds the admin-set target: for a given (project, contractor,
// trade) pair, how many workers should be on site every working day.
// Effective from `startDate` and (optionally) until `endDate`; the newest
// non-expired plan for a (contractor, trade) wins.
//
// ManpowerEntry is what the site engineer logs from mobile each day —
// (date, contractor, trade, actual count). One entry per (date, contractor,
// trade), enforced by a unique index; a resubmit replaces the previous value
// so the report layer never sees duplicates.
//
// Both together power:
//   - Daily Report Section 4 (headcount vs plan for the day)
//   - Weekly Report Section 3 (7-day trend + trade breakdown)
//   - Dashboard "Daily Manpower" strip
// ---------------------------------------------------------------------------
model TradePlan {
  id           String    @id @default(cuid())
  projectId    String
  contractorId String
  trade        String // "Bar Bender" | "Carpenter" | "Helper" | "Mason" — see src/lib/manpower.ts
  plannedCount Int
  startDate    DateTime // when this plan takes effect
  endDate      DateTime? // NULL = still current
  notes        String?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("TradePlanCreator", fields: [createdById], references: [id])

  @@index([projectId, contractorId])
  @@index([projectId, startDate])
}

model ManpowerEntry {
  id             String   @id @default(cuid())
  projectId      String
  contractorId   String
  trade          String
  entryDate      DateTime // date the workers were on site (day-precision, stored at 00:00 UTC)
  actualCount    Int
  notes          String?
  idempotencyKey String?  @unique // dedupes offline-queue replays from mobile

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("ManpowerEntryCreator", fields: [createdById], references: [id])

  // One row per (project, contractor, trade, date) — a re-submit updates the
  // existing entry (via upsert in the POST handler) rather than duplicating.
  @@unique([projectId, contractorId, trade, entryDate])
  @@index([projectId, entryDate])
  @@index([contractorId, entryDate])
}

// One row per Colab CSV activity — mirrors the raw CSV so Weekly Report §1
// (and any future report that needs Colab-native aggregation) can compute
// Python-parity numbers directly instead of relying on the lossy fuzzy
// match to WBSNode. Physical_Progress = per-activity weight (0-100, all
// rows sum to ~100 for a full project).
model ColabActivity {
  id              String    @id @default(cuid())
  projectId       String
  activityId      String   // Colab CSV Activity_ID (unique per project)

  villaId         String?  // resolved from Location_Name
  sectionId       String?  // resolved from Sub_Location via colabSyncMapping

  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  progressDate    DateTime?

  physicalProgress Float   // Physical_Progress column (the weight)
  totalPct         Float?  // Total__Progress_% column (activity completion %)

  reasonCode      String?
  reasonNote      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, activityId])
  @@index([projectId])
  @@index([projectId, plannedEnd])
  @@index([projectId, progressDate])
}
